# GitHub personal access token with repo scope (read-only access is enough:
# Contents: Read-only on your repos, or classic PAT with "repo" scope).
GITHUB_TOKEN=

# Your GitHub username - only repos owned by this account are watched.
GITHUB_USERNAME=

# Branch to watch for new commits.
BRANCH=main

# Registry images are pushed to. Port 5000 required - registry.localdomain
# with no port resolves to 443 and refuses connections.
REGISTRY_URL=registry.localdomain:5000

# How often to poll the GitHub API, in seconds.
POLL_INTERVAL_SECONDS=300

# Where last-seen commit SHAs are persisted (mount a volume over its parent dir).
STATE_FILE=/data/state.json
