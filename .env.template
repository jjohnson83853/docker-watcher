# GitHub personal access token with repo scope (read-only access is enough:
# Contents: Read-only on your repos, or classic PAT with "repo" scope).
GITHUB_TOKEN=

# Your GitHub username - only repos owned by this account are watched.
GITHUB_USERNAME=jjohnson83853

# Branch to watch for new commits.
BRANCH=main

# Registry images are pushed to. Port 5000 required - registry.localdomain
# with no port resolves to 443 and refuses connections.
REGISTRY_URL=registry.localdomain:5000

# Docker daemon the watcher builds/pushes through, via the host-published
# docker-socket-proxy endpoint (not a raw socket mount). This is the proven
# endpoint: the same address already builds five repos in production today
# (design.md EF-5, ADR-1). Fallback if it ever stalls: switch to
# unix:///var/run/docker.sock plus a bind mount of the socket - a one-line
# change, no code impact.
DOCKER_HOST=tcp://docker-lxc.localdomain:2375

# Selects daemon-side BuildKit (1) vs the classic builder (0). Kept as an
# env knob rather than baked into the image (ADR-2). Must be 0: the
# Dockerfile deliberately does not install docker-cli-buildx (ADR-2 - the
# socket-proxy's GRPC=0 ACL rejects the HTTP Upgrade buildx's
# docker-container driver needs). On docker-cli 29.5.3 (pinned in the
# Dockerfile), DOCKER_BUILDKIT=1 requires the buildx plugin - there is no
# legacy non-buildx BuildKit path anymore - so 1 here fails every build with
# "buildx component is missing or broken". Only set this to 1 if you
# separately add docker-cli-buildx to the Dockerfile, which is not
# recommended given the GRPC=0 constraint above.
DOCKER_BUILDKIT=0

# Do NOT set DOCKER_TLS_VERIFY here - it is a cargo-culted bug copied
# between the old per-repo runner configs. A non-empty value means "verify
# TLS", which is wrong for this plaintext endpoint (design.md ss4).

# How often to poll the GitHub API, in seconds.
POLL_INTERVAL_SECONDS=300

# Per-subprocess timeout (clone/build/push each get this), in seconds.
# A hung build must not hang the process forever (NFR-6).
BUILD_TIMEOUT_SECONDS=1800

# Where last-seen commit SHAs are persisted (mount a volume over its parent dir).
STATE_FILE=/data/state.json
